# Jalon A股投研工作台 —— 只填你实际使用的一家模型即可
# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。Web UI 侧边栏也可直接填写。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=

# Claude Agent SDK provider（仅个人自用，可选依赖 [agentsdk]）。
# 让 deep_thinking_llm 节点走你个人 Claude Pro/Max 订阅额度而非按 token 计费的 API。
# 用 `claude setup-token`（已登录 Pro/Max 账号）生成后填这里。
# ⚠️ 与 ANTHROPIC_API_KEY 不可共存：API key 优先级更高会悄悄走 API 计费，
#    启用该 provider 时若检测到 ANTHROPIC_API_KEY 会直接报错中止（护栏）。
CLAUDE_CODE_OAUTH_TOKEN=

# ── Web 多用户（可选；详见 MULTIUSER.md）────────────────────────────────────
# 注意：多用户模式下，上面这些 *_API_KEY 只对 owner 生效；普通成员在
# 「👤 账户 → API Key」里保存自己的 Key（存到各自账户目录，不进 .env）。
# CLI 仍然直接读这里的 Key。
#
# 账户数硬上限（管理员只能在此基础上调低）
TRADINGAGENTS_MAX_USERS=10
# 全服务器同时运行的分析数 / 单成员每日次数 / 单账户磁盘配额 MB
TRADINGAGENTS_MAX_CONCURRENT_RUNS=4
TRADINGAGENTS_MAX_RUNS_PER_DAY=20
TRADINGAGENTS_USER_QUOTA_MB=2048
# 数据根目录（默认 ~/.tradingagents；容器/测试可改）
# TRADINGAGENTS_HOME=/home/appuser/.tradingagents
#
# 应用只在反向代理后面时开启：从 X-Forwarded-For 取真实 IP 做限流。
# 直接暴露 8501 时绝不要开（客户端可伪造 IP）。
# TRADINGAGENTS_TRUST_PROXY=1
#
# 可选：反向代理已认证时自动登录（应用必须只监听 127.0.0.1）。
# TRADINGAGENTS_TRUSTED_HEADER=X-Auth-User
# TRADINGAGENTS_TRUSTED_SECRET=换成一串随机长字符串
# TRADINGAGENTS_TRUSTED_SECRET_HEADER=X-Auth-Secret
# 成员自定义 API Base URL 默认只允许公网目标（防 SSRF / 云元数据 / 内网探测）。
# 如果成员必须接你内网/本机的中转，才设为 1（服务器级开关，成员不能自己开）。
# TRADINGAGENTS_ALLOW_PRIVATE_BASE_URLS=0
